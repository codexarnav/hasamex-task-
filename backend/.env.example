# InsightOS V1 Environment Configuration

# Application
APP_NAME=InsightOS
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://insightos:insightos@localhost:5432/insightos

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=research_utterances

# Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=3072

# Storage
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=50

# AI Configuration
MAX_LLM_RETRIES=2
EVIDENCE_TOP_K=20
EVIDENCE_MIN_RELEVANCE=0.5

# Server
HOST=0.0.0.0
PORT=8000
